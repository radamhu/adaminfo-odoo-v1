<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Each section is a plain oe_structure zone: editable/drag-droppable in
         Website Builder without any custom snippet registration. -->

    <template id="section_hero" name="Hero">
        <section id="hero" class="oe_structure s_text_block o_cc o_cc1 pt48 pb64 text-center">
            <div class="container">
                <!-- The banner art already carries the name, tagline and stack;
                     the h1 stays for screen readers and SEO. -->
                <h1 class="visually-hidden">Adam Informatika — Freelancer</h1>
                <img src="/website_adaminfo_theme/static/src/img/adaminformatika_banner.webp"
                     class="img-fluid o_adaminfo_banner mb-4" width="1540" height="523"
                     loading="eager" fetchpriority="high"
                     alt="Adam Informatika, freelancer: AWS cloud solutions, Python developer, Odoo developer, DevOps automate and scale. Build, automate, deploy, scale. Reliable solutions, real impact."/>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="#contact" class="btn btn-primary btn-lg">Get in touch</a>
                    <a href="#projects" class="btn btn-outline-primary btn-lg">View projects</a>
                </div>
            </div>
        </section>
    </template>

    <template id="section_about" name="About">
        <section id="about" class="oe_structure s_text_block o_cc o_cc2 pt64 pb64">
            <div class="container text-center">
                <h2>About</h2>
                <p class="mx-auto mb-4" style="max-width: 640px;">Freelance IT PM, DevOps engineer, and Python/Odoo developer —
                   building and automating systems that hold up in production.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <span class="d-inline-block rounded-pill o_adaminfo_pill">AWS &#8212; Cloud Solutions</span>
                    <span class="d-inline-block rounded-pill o_adaminfo_pill">Python &#8212; Developer</span>
                    <span class="d-inline-block rounded-pill o_adaminfo_pill">Odoo &#8212; Developer</span>
                    <span class="d-inline-block rounded-pill o_adaminfo_pill">DevOps &#8212; Automate &amp; Scale</span>
                </div>
            </div>
        </section>
    </template>

    <template id="section_projects" name="Projects">
        <section id="projects" class="oe_structure s_three_columns o_cc o_cc1 pt64 pb64">
            <div class="container">
                <h2 class="text-center mb-4">Projects</h2>
                <div class="row">
                    <div class="col-lg-6 pt16 pb16">
                        <div class="card h-100 o_cc o_cc2 o_adaminfo_project_card">
                            <div class="card-body p-4">
                                <i class="fa fa-2x fa-tachometer o_adaminfo_project_icon mb-3"/>
                                <h3 class="h4">Customer Operations Dashboard</h3>
                                <p>Odoo addon surfacing per-customer financial and
                                   operational metrics on the partner form.</p>
                                <a href="https://www.linkedin.com/in/adaminformatika/details/projects/" target="_blank" rel="noopener" class="stretched-link">
                                    <i class="fa fa-linkedin me-2"/>View on LinkedIn</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 pt16 pb16">
                        <div class="card h-100 o_cc o_cc2 o_adaminfo_project_card">
                            <div class="card-body p-4">
                                <i class="fa fa-2x fa-exchange o_adaminfo_project_icon mb-3"/>
                                <h3 class="h4">Odoo migration tooling</h3>
                                <p>oec.sh API client and CLI suite: preflight,
                                   cutover-check, lifecycle, log-watch.</p>
                                <a href="https://www.linkedin.com/in/adaminformatika/details/projects/" target="_blank" rel="noopener" class="stretched-link">
                                    <i class="fa fa-linkedin me-2"/>View on LinkedIn</a>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-center mt-4 mb-0">
                    <a href="https://www.linkedin.com/in/adaminformatika/details/projects/" target="_blank" rel="noopener" class="btn btn-outline-primary">
                        <i class="fa fa-linkedin me-2"/>All projects on LinkedIn</a>
                </p>
            </div>
        </section>
    </template>

    <template id="section_contact" name="Contact">
        <section id="contact" class="oe_structure o_cc o_cc2 pt64 pb64">
            <div class="container">
                <h2 class="text-center mb-4">Contact</h2>
                <!-- Real s_website_form markup, pulled verbatim from this env's
                     own /contactus page (adaminfo-dev-1869) after the website
                     module went live — not hand-authored. The hidden
                     website_form_signature is a server-computed hash tied to
                     this exact field set; don't trim fields without
                     regenerating it through the Website Builder's own form
                     editor. -->
                <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                    <div class="container" style="max-width: 640px;">
                        <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="contact1">
                                        <span class="s_website_form_label_content">Name</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input id="contact1" type="text" class="form-control s_website_form_input" name="name" required="required" data-fill-with="name"/>
                                </div>
                                <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="contact2">
                                        <span class="s_website_form_label_content">Phone Number</span>
                                    </label>
                                    <input id="contact2" type="tel" class="form-control s_website_form_input" name="phone" data-fill-with="phone"/>
                                </div>
                                <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required" data-type="email" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="contact3">
                                        <span class="s_website_form_label_content">Email</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input id="contact3" type="email" class="form-control s_website_form_input" name="email_from" required="required" data-fill-with="email"/>
                                </div>
                                <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="contact4">
                                        <span class="s_website_form_label_content">Company</span>
                                    </label>
                                    <input id="contact4" type="text" class="form-control s_website_form_input" name="company" data-fill-with="commercial_company_name"/>
                                </div>
                                <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="contact5">
                                        <span class="s_website_form_label_content">Subject</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <input id="contact5" type="text" class="form-control s_website_form_input" name="subject" required="required"/>
                                </div>
                                <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                                    <label class="s_website_form_label" style="width: 200px" for="contact6">
                                        <span class="s_website_form_label_content">Question</span>
                                        <span class="s_website_form_mark"> *</span>
                                    </label>
                                    <textarea id="contact6" class="form-control s_website_form_input" name="description" required="required" rows="8"/>
                                </div>
                                <div class="mb-3 col-12 s_website_form_field s_website_form_dnone">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="contact7">
                                            <span class="s_website_form_label_content">Email To</span>
                                        </label>
                                        <div class="col-sm">
                                            <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                            <input type="hidden" value="910417fa8ea034bbe9c4cbf518f325148664fe76d1a84c182f81851ce5790920" class="form-control s_website_form_input s_website_form_custom" name="website_form_signature"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                                    <div style="width: 200px;" class="s_website_form_label"/>
                                    <a href="#" role="button" class="btn btn-primary s_website_form_send">Submit</a>
                                    <span id="s_website_form_result"/>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>
                <p class="text-center mt-4 mb-0">
                    <a href="https://www.linkedin.com/in/adaminformatika" target="_blank" rel="noopener">
                        <i class="fa fa-linkedin me-2"/>Connect on LinkedIn</a>
                </p>
            </div>
        </section>
    </template>
</odoo>
